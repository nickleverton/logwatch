use Logwatch ':format';
use strict;
my $Detail = $ENV{'LOGWATCH_DETAIL_LEVEL'} || 0;
my %CertificateExpired;
my %CannotIndex;
my $DaemonStart;
my $DaemonStartTime;
my $DaemonStop;
my $error;
my %Errors;
my $item;
my $message;
my $module;
my %OtherList;
my $remote;
my $ThisLine;
my %Warnings;

while (defined(my $ThisLine = <STDIN>)) {
   # Strip initial date
   $ThisLine =~ s/^\[\d+[^]]*\]//;
   # Strip ID
   $ThisLine =~ s/\[[0-9a-f]*\]//;
   # Strip backtrace
   $ThisLine =~ s/backtrace=>\[.*//;
   # Remove changing numbers
   $ThisLine =~ s/will_retry_in_seconds=>\d+/will_retry/;
   $ThisLine =~ s/,\\"invalid-event-number\\":\d+//;

   if (( $ThisLine =~ /^\s*Caused by:/ ) or
       ( $ThisLine =~ /^\s*at / ) or
       ( $ThisLine =~ /^\s\.\.\. \d+ more$/ ) or
       ( $ThisLine =~ /^java.lang.NullPointerException: null/ ) or
       ( $ThisLine =~ /Fixnum is deprecated/ ) or
       ( $ThisLine =~ /^logstash.service: Succeeded/ ) or
       ( $ThisLine =~ /^Sending Logstash logs to/ ) or
       ( $ThisLine =~ /Shutting down/ ) or
       ( $ThisLine =~ /^Stopping/ ) or
       ( $ThisLine =~ /^Using bundled JDK/ ) or
       ( $ThisLine =~ /\]\s*$/ ) or
       0 # This line prevents blame shifting as lines are added above
       ) {
       # We do not care about these.
   } elsif (($error) = ($ThisLine =~ /Could not index event to .* \{.*"error"=>\{([^}]*)/)) {
      $CannotIndex{$error}++;
   # INFO
   } elsif (($remote) = ($ThisLine =~ /remote: ([^:]+):.*CertificateExpiredException/)) {
       $CertificateExpired{$remote}++;
   } elsif ($ThisLine =~ /^Started/) {
      $DaemonStart++;
   } elsif ($ThisLine =~ /^Stopped/) {
      $DaemonStop++;
   } elsif ($ThisLine =~ /\[INFO \]/) {
      # Ignore INFO messages other than the ones processed above
   } elsif (($module, $item, $message) = ($ThisLine =~ /\[ERROR\]\[(\S+)\s*\]\[(\S+)\s*\] (.*)/)) {
      $Errors{$module}{$item}{$message} += 1;
   } elsif (($module, $item, $message) = ($ThisLine =~ /\[WARN \]\[(\S+)\s*\]\[(\S+)\s*\] (.*)/)) {
      $Warnings{$module}{$item}{$message} += 1;
   } else {
      $OtherList{$ThisLine}++;
   }
}

print(FormatHashCounts(%Errors, "ERRORS"));
print(FormatHashCounts(%Warnings, "Warnings"));

if (($DaemonStop) and ($Detail >= 5)) {
   print "\nDaemon stopped: ". $DaemonStop." Time(s)\n";
}

if (keys %CannotIndex) {
   print "\nCould not index event:\n";
   foreach $error (sort {$a cmp $b} keys %CannotIndex) {
      printf "   %-50s %5i Time(s)\n", $error .":", $CannotIndex{$error};
   }
}

if (keys %CertificateExpired) {
   print "\nRemote Certificate Expired:\n";
   foreach $remote (sort {$a cmp $b} keys %CertificateExpired) {
      printf "   %-50s %5i Time(s)\n", $remote .":", $CertificateExpired{$remote};
   }
}

if (keys %OtherList) {
   print "\n**Unmatched Entries**\n";
   foreach $ThisLine (sort {$a cmp $b} keys %OtherList) {
      printf "   %-50s %5i Time(s)\n", $ThisLine .":", $OtherList{$ThisLine};
   }
}

exit(0);

