my $Detail;
if (defined $ENV{'dovecot_detail'}) {
   $Detail = $ENV{'dovecot_detail'}
   } elsif (defined $ENV{'LOGWATCH_DETAIL_LEVEL'}) {
      $Detail = $ENV{'LOGWATCH_DETAIL_LEVEL'}
   } else {
