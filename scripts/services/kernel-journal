# This is the journald-sourced counterpart to the 'kernel' service, for
# hosts (e.g. Proxmox VE, or any journald-only system) that have no
# /var/log/messages (or similar) file for 'kernel' to read.  See
# conf/services/kernel-journal.conf: it feeds this service kernel-facility
# lines via journalctl instead of a logfile.  It shares the exact same
# parser as 'kernel' to avoid duplicating that logic.
#
# Runs by default (see logwatch.conf), alongside the plain 'kernel'
# service, so the two guards below keep them from double-reporting:
# logwatch.pl has no way for one service's config to disable another, so
# this has to self-exclude at runtime instead.

use strict;
use FindBin qw($Bin);

# Guard 1: no journalctl on this host -- nothing to source, and running
# *JournalCtl anyway would just dump a "No such file or directory" error
# into the report. Bail out silently.
exit(0) unless have_journalctl();

# Guard 2: the classic messages logfile already has content, so the
# 'kernel' service is already covering this host -- defer to it rather
# than reporting the same kernel messages twice. This only checks the
# exact paths the stock conf/logfiles/messages.conf resolves to under the
# default LogDir search (/var/adm, /var/log); a custom LogDir won't be
# seen here, so this is a heuristic, not a guarantee.
for my $messages_candidate (qw(/var/adm/messages /var/log/messages)) {
   exit(0) if -s $messages_candidate;
}

do "$Bin/kernel";
die $@ if $@;

sub have_journalctl {
   for my $dir ( split /:/, $ENV{PATH} || '' ) {
      return 1 if -x "$dir/journalctl";
   }
   return 0;
}
